[]byte("# The workflow the e2e test runs through Tentmaker in checks mode. Tent wher\n# posts its result as the commit statuses tentmaker/smoke and\n# tentmaker/smoke-windows. GitHub's own runners run it too, where it does\n# nothing but echo: GitHub sets GITHUB_ACTIONS=true and Tentmaker does not,\n# and e2e.yml checks the Tentmaker log for TENTMAKER=1 GITHUB_ACTIONS=unset.\nname: tentmaker-smoke\n\non:\n  push:\n  pull_request:\n  workflow_dispatch:\n\npermissions:\n  contents: read\n\njo\x0es:\n  smoke:\n    runs-on: ubuntu-latest\n    timeout-minutes: 5\n    steps:\n      - run: echo \"tentmaker-smoke TENTMAKER=${TENTMAKER:-unset} GITHUB_ACTIONS=${GITHUB_ACTIONS:-unset} RUNNER_OS=$RUNNER_OS\"\n      - run: test \"$TENTMAKER\" = 1 || test \"${GITHUB_ACTIONS:-}\" = true\n\n  smoke-windows:\n    runs-on: windows-latest\n    timeout-minutes: 5\n    steps:\n      - shell: pwsh\n        run: Write-Output \"tentmaker-smoke TENTMAKER=$(if ($env:TENTMAKER) { $env:TENTMAKER } else { 'unset' }) GITHUB_ACTIONS=$(if ($env:GITHUB_ACTIONS) { $env:GITHUB_ACTIONS } else { 'unset' }) RUNNER_OS=$env:RUNNER_OS\"\n      - shell: pwsh\n        run: if ($env:TENTMAKER -ne '1' -and $env:GITHUB_ACTIONS -ne 'true') { exit 1 }\n")
byte('\x01')
